# =============================================================================
# Star Sign PROD — zmienne środowiskowe dla Portainera (stack: star_sign_production)
#
# Wzorzec: deploy/vps/portainer.env.example z konstruo_app (VentiPlan).
# Uzupełniona kopia zawiera sekrety ENV: przechowuj ją poza repo z dostępem 600.
# Wartości wpisz w Portainer: Stacks → Environment variables → Advanced mode
# (wklej całą treść). Nie dołączaj wypełnionego pliku do repo ani raportów.
#
# Sekcje: obrazy/domeny → baza → cache → Strapi sekrety → AICO treść →
#          AICO social (FB/IG/X — „wklej tokeny i działa") → monetyzacja →
#          e-mail → bezpieczeństwo → monitoring → opcjonalne integracje.
# =============================================================================

# ── Obrazy i domeny ──────────────────────────────────────────────────────────
# Ruchomy tag :prod — workflow przepina go na każdy SHA (rollback: workflow
# "Production Rollback" przepina :prod na starszy SHA i strzela webhook).
GHCR_OWNER=subscribe-it
STAR_SIGN_IMAGE_TAG=prod
PRODUCTION_DOMAIN=star-sign.pl
API_DOMAIN=api.star-sign.pl
UPLOAD_ASSET_CSP_ORIGINS=https://cdn.star-sign.pl
SSR_ALLOWED_HOSTS=star-sign.pl,www.star-sign.pl
TZ=Europe/Warsaw

# ── Baza danych (istniejąca — to jest volkswander, nie twórz od zera) ────────
# UWAGA MIGRACJI: przy pierwszym deploy nowego stacka te wartości MUSZĄ być
# identyczne ze starym stackiem, inaczej API nie podłączy się do bazy.
POSTGRES_DB=__TA_SAMA_BAZA_CO_STARY_STACK__
POSTGRES_USER=__TEN_SAMY_USER__
POSTGRES_PASSWORD=__HASLO_BAZY__
DATABASE_NAME=__TA_SAMA_BAZA__
DATABASE_USERNAME=__TEN_SAMY_USER__
DATABASE_PASSWORD=__HASLO_BAZY__
DATABASE_SSL=false

# ── Redis (cache HTTP + rate limit) ─────────────────────────────────────────
REDIS_PASSWORD=__HASLO_REDIS__

# ── Sekrety Strapi (przeklej ze starego stacka — NIE regeneruj!) ────────────
# Regeneracja = utrata sesji admin i dostępu do zaszyfrowanych tokenów AICO.
JWT_SECRET=__ZE_STAREGO_STACKA__
ADMIN_JWT_SECRET=__ZE_STAREGO_STACKA__
API_TOKEN_SALT=__ZE_STAREGO_STACKA__
TRANSFER_TOKEN_SALT=__ZE_STAREGO_STACKA__
APP_KEYS=__ZE_STAREGO_STACKA__
ENCRYPTION_KEY=__ZE_STAREGO_STACKA__
AICO_AUDIT_IP_HASH_SALT=__ZE_STAREGO_STACKA__

# ── AICO: generowanie treści (jedyne co potrzebne do startu) ────────────────
AICO_ENABLE_WORKFLOWS=true
AICO_OPENROUTER_TOKEN=__TOKEN_OPENROUTER__
AICO_OPENROUTER_MODEL=openai/gpt-4.1-mini
AICO_SYNC_EDITOR_ROLE_PERMISSIONS=true
AICO_AUTO_PUBLISH_ENABLED=true
AICO_SOCIAL_CHANNELS=facebook,instagram,twitter

# Generowanie obrazów (opcjonalne — bez tokena artykoly sa bez ilustracji)
AICO_IMAGE_GEN_TOKEN=__TOKEN_REPLICATE__
AICO_IMAGE_GEN_MODEL=__MODEL__

# ── AICO social: „wklej tokeny i działa" — puste = kanał nie publikuje ──────
# Facebook: aplikacja z pages_manage_posts + Page Access Token
AICO_FACEBOOK_PAGE_ID=__ID_STRONY_FB__
AICO_FACEBOOK_ACCESS_TOKEN=__PAGE_TOKEN_FB__
# Instagram: konto biznesowe podpięte pod stronę FB + token Graph API
AICO_INSTAGRAM_USER_ID=__ID_KONTA_IG__
AICO_INSTAGRAM_ACCESS_TOKEN=__TOKEN_IG__
# X: OAuth 1.0a — komplet 4 wartości z developer.x.com
AICO_X_API_KEY=__API_KEY_X__
AICO_X_API_SECRET=__API_SECRET_X__
AICO_X_ACCESS_TOKEN=__ACCESS_TOKEN_X__
AICO_X_ACCESS_TOKEN_SECRET=__ACCESS_TOKEN_SECRET_X__

# ── Monetyzacja: Stripe ─────────────────────────────────────────────────────
STRIPE_REQUIRED=true
STRIPE_SECRET_KEY=__KLUCZ_STRIPE__
STRIPE_WEBHOOK_SECRET=__WEBHOOK_SECRET_STRIPE__
STRIPE_PREMIUM_MONTHLY_PRICE_ID=__PRICE_ID_M__
STRIPE_PREMIUM_ANNUAL_PRICE_ID=__PRICE_ID_A__
PREMIUM_MODE=true

# ── E-mail: Brevo ───────────────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=__USER_BREVO__
BREVO_SMTP_PASSWORD=__HASLO_BREVO__
BREVO_REPLY_TO=kontakt@star-sign.pl
BREVO_WEBHOOK_SECRET=__SECRET_BREVO__
NEWSLETTER_DOUBLE_OPT_IN=true

# ── Sklep / ads (feature flags — domyślnie wyłączone jak dotąd) ──────────────
SHOP_ENABLED=false
FRONTEND_SHOP_ENABLED=false
ADSENSE_CLIENT_ID=
GTM_CONTAINER_ID=

# ── Monitoring / Sentry ──────────────────────────────────────────────────────
SENTRY_DSN=__DSN_API__
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
FRONTEND_SENTRY_DSN=__DSN_FRONT__

# ── R2 / media (przeklej ze starego stacka) ────────────────────────────────
# Wartości R2 siedzą w sekretach stacku (jeśli tam były) — sprawdź stary stack.

# ── Rate limit / cache / turnstile (defaults bezpieczne — patrz stack yml) ──
# Zostaw puste jeśli nie masz powodu zmieniać; stack yml ma sensowne defaults.
